  "references": [
    {
      "id": "keel-baseline",
      "kind": "plane",
      "normal": [0, 0, 1],
      "offsetM": 0
    },
    {
      "id": "aft-datum",
      "kind": "plane",
      "normal": [1, 0, 0],
      "offsetM": 0
    },
    {
      "id": "sheer",
      "kind": "polyline",
      "pointsM": [
        [0, -1, 2],
        [4, -1, 2],
        [4, 1, 2],
        [0, 1, 2]
